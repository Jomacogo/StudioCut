/* ==========================================================================
   TEMA PROFESIONAL DARK STUDIO - NLE VIDEO EDITOR
   ========================================================================== */

* {
    outline: none;
    font-family: "Segoe UI", "Inter", -apple-system, sans-serif;
}

QMainWindow, QWidget#CentralRoot {
    background-color: #0e1017;
    color: #e2e8f0;
}

QWidget {
    color: #cbd5e1;
    font-size: 12px;
}

/* -------------------------------------------------- Paneles y Splitters */
QSplitter::handle {
    background-color: #1a1e2b;
}

QSplitter::handle:horizontal {
    width: 3px;
}

QSplitter::handle:vertical {
    height: 3px;
}

QSplitter::handle:hover {
    background-color: #3b82f6;
}

QFrame#PanelContainer {
    background-color: #141722;
    border: 1px solid #232838;
    border-radius: 8px;
}

/* -------------------------------------------------- Pestañas / Tabs NLE */
QTabWidget::pane {
    border: 1px solid #232838;
    background-color: #141722;
    border-radius: 6px;
    top: -1px;
}

QTabBar::tab {
    background: #11131c;
    color: #94a3b8;
    border: 1px solid #232838;
    border-bottom: none;
    padding: 7px 16px;
    margin-right: 2px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    font-weight: 500;
}

QTabBar::tab:selected {
    background: #1a1e2b;
    color: #38bdf8;
    border-bottom: 2px solid #38bdf8;
    font-weight: 600;
}

QTabBar::tab:hover:!selected {
    background: #161924;
    color: #e2e8f0;
}

/* -------------------------------------------------- GroupBox */
QGroupBox {
    background: #141722;
    border: 1px solid #232838;
    border-radius: 8px;
    margin-top: 14px;
    padding: 12px 10px 10px 10px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    color: #94a3b8;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

/* -------------------------------------------------- Botones */
QPushButton {
    background-color: #1e2333;
    border: 1px solid #2f364a;
    border-radius: 5px;
    padding: 6px 14px;
    color: #e2e8f0;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #282f44;
    border-color: #3e4761;
}

QPushButton:pressed {
    background-color: #171b28;
    border-color: #1e2333;
}

QPushButton:disabled {
    color: #555d73;
    background-color: #161822;
    border-color: #202330;
}

/* Botón Primario (Render / Acción clave) */
QPushButton#primary, QPushButton[accent="true"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #2563eb, stop:1 #3b82f6);
    border: 1px solid #60a5fa;
    color: #ffffff;
    font-weight: 600;
}

QPushButton#primary:hover, QPushButton[accent="true"]:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #1d4ed8, stop:1 #2563eb);
    border-color: #93c5fd;
}

/* Botón Detección AI */
QPushButton#btn_ai {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #7c3aed, stop:1 #8b5cf6);
    border: 1px solid #a78bfa;
    color: #ffffff;
    font-weight: 600;
}

QPushButton#btn_ai:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #6d28d9, stop:1 #7c3aed);
}

/* -------------------------------------------------- Listas y Tablas */
QListWidget, QTableWidget {
    background-color: #0f1118;
    border: 1px solid #232838;
    border-radius: 6px;
    padding: 2px;
    gridline-color: #1c2130;
    selection-background-color: #1e3a8a;
    selection-color: #ffffff;
}

QListWidget::item {
    padding: 6px 8px;
    border-radius: 4px;
    margin: 1px 2px;
}

QListWidget::item:hover {
    background-color: #1a2030;
    color: #f8fafc;
}

QListWidget::item:selected {
    background-color: #2563eb;
    color: #ffffff;
}

QTableWidget::item {
    padding: 4px 6px;
}

QTableWidget::item:selected {
    background-color: #1d4ed8;
    color: #ffffff;
}

QHeaderView::section {
    background-color: #171b26;
    color: #94a3b8;
    border: none;
    border-bottom: 1px solid #272d3f;
    padding: 6px 8px;
    font-weight: 600;
    font-size: 11px;
}

/* -------------------------------------------------- Entradas de Texto y Combos */
QLineEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox, QComboBox, QDateTimeEdit {
    background-color: #0d0f16;
    border: 1px solid #252b3b;
    border-radius: 5px;
    padding: 5px 8px;
    color: #f1f5f9;
    selection-background-color: #2563eb;
}

QLineEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus,
QComboBox:focus, QDateTimeEdit:focus {
    border: 1px solid #3b82f6;
    background-color: #11141e;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 22px;
    border-left: 1px solid #252b3b;
}

QComboBox QAbstractItemView {
    background-color: #131620;
    border: 1px solid #2e3549;
    selection-background-color: #2563eb;
    selection-color: #ffffff;
    padding: 4px;
}

/* -------------------------------------------------- Barra de Progreso */
QProgressBar {
    background-color: #11131a;
    border: 1px solid #232838;
    border-radius: 5px;
    height: 8px;
    text-align: center;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #3b82f6, stop:0.7 #06b6d4, stop:1 #10b981);
    border-radius: 4px;
}

/* -------------------------------------------------- Áreas de Desplazamiento */
QScrollArea {
    background: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background: transparent;
}

/* -------------------------------------------------- Barras de Desplazamiento */
QScrollBar:vertical {
    background: #0f1118;
    width: 8px;
    margin: 0;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background: #272e42;
    min-height: 24px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #3b4562;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
    background: none;
}

QScrollBar:horizontal {
    background: #0f1118;
    height: 8px;
    margin: 0;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    background: #272e42;
    min-width: 24px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal:hover {
    background: #3b4562;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
    background: none;
}

/* -------------------------------------------------- Checkbox y Radio */
QCheckBox {
    spacing: 8px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #333c52;
    border-radius: 4px;
    background: #0f1118;
}

QCheckBox::indicator:hover {
    border-color: #3b82f6;
}

QCheckBox::indicator:checked {
    background: #2563eb;
    border-color: #60a5fa;
}

QCheckBox::indicator:disabled {
    background: #141824;
    border-color: #232838;
}

/* -------------------------------------------------- Ventana de YouTube */
QLabel#YouTubeStatus {
    color: #7dd3fc;
    font-size: 11px;
}

QLabel#HintLabel {
    color: #64748b;
    font-size: 10px;
}

/* ------------------------------------------------- IA local (panel IA) */
QFrame#IALocalBox {
    background: #131722;
    border: 1px solid #232838;
    border-radius: 6px;
}

/* -------------------------------------------------- Barra de Estado */
QStatusBar {
    background: #0b0d13;
    border-top: 1px solid #1a1e2b;
    color: #94a3b8;
    font-size: 11px;
}
